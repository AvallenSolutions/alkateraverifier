# alkatera LCA Verifier — environment variables (PRD § Stack Integration Guide)
# Copy to .env.local and fill in. Never commit real values.
# Set SKIP_ENV_VALIDATION=1 to bypass validation in CI builds without secrets.

# --- App (required) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (required) — Postgres, Auth, Storage ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sentry (Phase 0, TASK-011) — error tracking ---
# Same DSN in both; the NEXT_PUBLIC copy is for the browser SDK (not a secret).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional, for source-map upload in CI/Vercel:
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Anthropic Claude (Phase 1, TASK-016) — extraction + clause reasoning ---
ANTHROPIC_API_KEY=

# --- Stripe (Phase 3, TASK-033) — paid unlock ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# One-time paid-unlock price. Create it with: node scripts/setup-stripe.mjs
STRIPE_PRICE_ID=

# --- PostHog (Phase 2, TASK-032) — analytics funnel ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Resend (Phase 3, TASK-039) — transactional email ---
RESEND_API_KEY=
